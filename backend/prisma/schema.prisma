generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Utilisateurs & habilitations (cahier des charges §3, §5.7) ----------

enum Role {
  CITOYEN
  ORGANISATION
  AGENT
  RESPONSABLE
  EDITEUR
  ADMIN_FONCTIONNEL
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  phone            String?
  passwordHash     String
  role             Role          @default(CITOYEN)
  status           AccountStatus @default(PENDING_VERIFICATION)
  firstName        String?
  lastName         String?
  organizationName String? // raison sociale pour le profil ORGANISATION
  emailVerifiedAt  DateTime?
  termsAcceptedAt  DateTime
  failedLogins     Int           @default(0)
  lockedUntil      DateTime?
  mfaSecret        String? // obligatoire pour ADMIN_FONCTIONNEL / SUPER_ADMIN (à venir)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  services         UserService[]
  refreshTokens    RefreshToken[]
  dossiers         Dossier[]        @relation("DossierApplicant")
  assignedDossiers Dossier[]        @relation("DossierAssignee")
  histories        DossierHistory[]
  messages         DossierMessage[]
  auditLogs        AuditLog[]

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Services municipaux ----------

model Service {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  email        String?
  phone        String?
  address      String?
  openingHours String?
  domains      String[] @default([]) // domaines de compétence affichés sur le portail (§4.2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members        UserService[]
  procedureTypes ProcedureType[]
  dossiers       Dossier[]
}

model UserService {
  userId    String
  serviceId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

// ---------- Démarches & workflow configurable (§5.6, §6.1) ----------

enum OnlineMode {
  FULL
  PARTIAL
  IN_PERSON
}

model ProcedureType {
  id             String     @id @default(uuid())
  code           String     @unique // ex: SIGNALEMENT, ATTESTATION_DOMICILE
  name           String
  category       String
  description    String?
  conditions     String?
  requiredDocs   Json? // liste des pièces requises
  formSchema     Json? // champs du formulaire (versionné via formVersion)
  formVersion    Int        @default(1)
  indicativeDays Int?
  fee            Decimal?   @db.Decimal(12, 2) // uniquement coût officiellement validé
  onlineMode     OnlineMode @default(FULL)
  active         Boolean    @default(false) // activer seulement après validation mairie
  serviceId      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  service  Service          @relation(fields: [serviceId], references: [id])
  statuses WorkflowStatus[]
  dossiers Dossier[]
}

model WorkflowStatus {
  id                 String  @id @default(uuid())
  procedureTypeId    String
  code               String
  label              String
  isInitial          Boolean @default(false)
  isFinal            Boolean @default(false)
  visibleToApplicant Boolean @default(true)
  isDecision         Boolean @default(false) // entrer dans ce statut enregistre une décision (accepté, rejeté…)
  position           Int     @default(0)

  procedureType ProcedureType        @relation(fields: [procedureTypeId], references: [id], onDelete: Cascade)
  outgoing      WorkflowTransition[] @relation("From")
  incoming      WorkflowTransition[] @relation("To")
  dossiers      Dossier[]

  @@unique([procedureTypeId, code])
}

model WorkflowTransition {
  id             String  @id @default(uuid())
  fromStatusId   String
  toStatusId     String
  allowedRoles   Role[]
  requiresReason Boolean @default(false)

  from WorkflowStatus @relation("From", fields: [fromStatusId], references: [id], onDelete: Cascade)
  to   WorkflowStatus @relation("To", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}

// ---------- Dossiers (§5.2, §6) ----------

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Dossier {
  id              String    @id @default(uuid()) // identifiant non devinable
  reference       String    @unique // lisible: KM-2026-000123
  procedureTypeId String
  applicantId     String
  statusId        String
  serviceId       String
  assigneeId      String?
  priority        Priority  @default(NORMAL)
  formVersion     Int
  data            Json // contenu du formulaire tel que déposé
  decision        String?
  decisionReason  String?
  submittedAt     DateTime  @default(now())
  closedAt        DateTime?
  dueAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  procedureType ProcedureType    @relation(fields: [procedureTypeId], references: [id])
  applicant     User             @relation("DossierApplicant", fields: [applicantId], references: [id])
  assignee      User?            @relation("DossierAssignee", fields: [assigneeId], references: [id])
  status        WorkflowStatus   @relation(fields: [statusId], references: [id])
  service       Service          @relation(fields: [serviceId], references: [id])
  history       DossierHistory[]
  messages      DossierMessage[]
  attachments   Attachment[]

  @@index([applicantId])
  @@index([serviceId, statusId])
  @@index([assigneeId])
}

model DossierHistory {
  id           String   @id @default(uuid())
  dossierId    String
  actorId      String?
  fromStatusId String?
  toStatusId   String?
  action       String // CREATED, STATUS_CHANGED, ASSIGNED, COMPLEMENT_REQUESTED, ...
  reason       String?
  createdAt    DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([dossierId, createdAt])
}

model DossierMessage {
  id        String   @id @default(uuid())
  dossierId String
  authorId  String
  body      String
  internal  Boolean  @default(false) // note interne: jamais renvoyée au citoyen
  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([dossierId, createdAt])
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

model Attachment {
  id           String     @id @default(uuid())
  dossierId    String
  originalName String
  storageKey   String     @unique // nom interne, stockage privé
  mimeType     String
  size         Int
  sha256       String
  scanStatus   ScanStatus @default(PENDING)
  uploadedById String
  createdAt    DateTime   @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

// ---------- Traçabilité (§7) ----------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String // LOGIN, LOGIN_FAILED, ROLE_CHANGED, EXPORT, DECISION, ...
  entity    String?
  entityId  String?
  success   Boolean  @default(true)
  ip        String?
  meta      Json? // métadonnées minimales, jamais de données confidentielles
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ---------- Portail public (§4.1, §4.2) ----------

// Corps des textes : texte brut, un paragraphe par bloc, « ## » pour un intertitre, « - » pour une liste.
// Jamais de HTML : le front-end n'injecte aucun balisage venant de la base.

enum PageCategory {
  MAIRIE // présentation, missions, organisation
  LEGAL // confidentialité, mentions légales, conditions d'utilisation, accessibilité
}

model Page {
  id        String       @id @default(uuid())
  slug      String       @unique
  title     String
  summary   String?
  body      String
  category  PageCategory
  position  Int          @default(0)
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([category, published])
}

model NewsArticle {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

enum AnnouncementLevel {
  URGENT // bandeau sur toutes les pages
  CAMPAIGN // mise en avant sur l'accueil
}

model Announcement {
  id        String            @id @default(uuid())
  title     String
  body      String?
  level     AnnouncementLevel
  linkUrl   String? // chemin interne (/actualites/...) ou URL https
  linkLabel String?
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active, level])
}

model FaqEntry {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContentReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Signalement d'une information obsolète par un visiteur (§4.2).
model ContentReport {
  id        String              @id @default(uuid())
  pagePath  String
  pageTitle String?
  message   String
  email     String?
  status    ContentReportStatus @default(NEW)
  createdAt DateTime            @default(now())
  handledAt DateTime?

  @@index([status, createdAt])
}

// Réglages éditoriaux du portail (coordonnées officielles, message institutionnel…).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
