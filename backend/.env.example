NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://keurmassar:keurmassar_dev@localhost:5433/keurmassar?schema=public"

# Générer des secrets longs et aléatoires en production (jamais commités)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

CORS_ORIGIN=http://localhost:4200

# Dev uniquement: active les comptes sans vérification e-mail
AUTO_ACTIVATE_ACCOUNTS=true
